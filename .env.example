# Copy this file to .env and add your own credential.
# Never commit .env or place a real API key in this file.

# Week 4 / Week 5 (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2

# Week 7 (Google Gemini). GOOGLE_API_KEY is also used by the optional Week 2 Gemini demo.
# Do not add GEMINI_MAX_RETRIES: Week 7 refuses to start if it is set
# (transport retries are fixed; application attempts are set by the batch command).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0
GEMINI_TIMEOUT_SECONDS=90

# Optional credential for the separate Week 2 Hugging Face demonstration.
HUGGINGFACEHUB_API_TOKEN=
